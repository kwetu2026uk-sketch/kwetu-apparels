{
  "name": "Enquiry",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "partner_school",
        "sponsor",
        "career",
        "general"
      ]
    },
    "name": {
      "type": "string",
      "title": "Name"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "role": {
      "type": "string",
      "title": "Role"
    },
    "organisation": {
      "type": "string",
      "title": "Organisation"
    },
    "contact_person": {
      "type": "string",
      "title": "Contact Person"
    },
    "students": {
      "type": "number",
      "title": "Number of Students"
    },
    "collaboration_type": {
      "type": "string",
      "title": "Collaboration Type"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "cv_uri": {
      "type": "string",
      "title": "CV File URI"
    },
    "cv_link": {
      "type": "string",
      "title": "CV Link"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "new",
        "in_progress",
        "closed"
      ],
      "default": "new"
    },
    "staff_note": {
      "type": "string",
      "title": "Staff Note"
    }
  },
  "required": [
    "type",
    "message"
  ]
}